// ============================================================================
// main.tx3 — Tx3 source for the bridge's transaction templates.
//
// This file declares everything the operator scripts under `scripts/`
// resolve against: the on-chain policy IDs, the assets, the datum and
// redeemer types, and the 12 tx templates that make up the bridge flow.
//
// For a high-level walkthrough of how these templates chain together
// (the order, the inputs/outputs of each tx, the role of the receipt
// NFTs and the reference scripts), see `BRIDGE_FLOW_DIAGRAM.md`.
// ============================================================================

// The off-chain party (operator wallet) that funds and signs the bridge transactions.
party User;

// ─── Policy IDs ─────────────────────────────────────────────────────────────
// Each value is the hash of the corresponding Plutus validator after
// parameter application — i.e. the on-chain identity of that script.

policy Phase1 = 0x68e200e78f684e2a848be807370db9a7ff773575982cafc2457012f9;
policy Phase2 = 0x2694be01c9fefd6ce78b5664f7e31aca5c364e7abaa68a0ea640be63;

policy ProofReceipt = 0xb153634f4741edb2b4bf061a924489ad52f93e7bec3716dd91b2a29a;

policy StakeDistributionMint = 0xa4b014681bd74955a6e2293f99189cb876c5c043757424edcc44152e;
policy StakeDistributionSpend = 0x2c6c8e6aa7e119a48c80bdfbd6401c69e8e856e3adb57b82abc3e9a2;

policy BridgeMinting = 0x65c7985c26383748f65ed812cd6c9f0689962c89f95ba86c8bf8c759;

policy LockingTxsUpdaterMint = 0xd6813158687efbae8199d9c35b6b9e5103079abb3daf376582fe25fd;
policy LockingTxsUpdaterSpend = 0xd0f200682744c8a10d6fb6c97c10e004c78ede2960869f4fe57be33b;

// ─── Assets ─────────────────────────────────────────────────────────────────

asset StakeDistributionNFT =
  0xa4b014681bd74955a6e2293f99189cb876c5c043757424edcc44152e."stake_distribution_asset";

asset LockingTxsUpdaterNFT =
  0xd6813158687efbae8199d9c35b6b9e5103079abb3daf376582fe25fd."TxsUpdaterNFT";

// The wrapped token minted on the Cardano side by `bridge_mint_tx`.
asset BridgedAsset =
  0x65c7985c26383748f65ed812cd6c9f0689962c89f95ba86c8bf8c759."token_asset_name";

// ─── Phase 1 / Phase 2 SNARK verification types ─────────────────────────────
// Datums and redeemers used by the split Mithril STM verification.

// Datum produced by `phase1_setup` and consumed by `phase2_verify`.
// Carries the cheap-side cryptographic state (transcript challenges,
// commitments) that the pairing check in phase 2 needs.
type Phase1State {
  rhs_prefix: Bytes,
  reduced_hash: Bytes,
  x1: Bytes,
  x3: Bytes,
  x4: Bytes,
  v: Bytes,
}

// Datum extending Phase1State with recovery controls and the
// `statement_hash` (bound to the Mithril `signed_message` that the
// SNARK certifies).
type Phase2State {
  proof_state: Phase1State,
  phase1_signer: Bytes,
  reclaim_after: Int,
  statement_hash: Bytes,
}

// Datum carried by the receipt UTxO produced after a successful
// `phase2_verify`. Downstream txs read this `statement_hash` to know
// which Mithril statement the receipt attests to.
type ProofReceiptDatum {
  statement_hash: Bytes,
}

// The non-trivial part of the SNARK proof — the G1 commitment points
// that are NOT verification-key constants — passed in as the `phase2`
// redeemer.
type ReducedRedeemer {
  vanishing_g: Bytes,
  vanishing_rand: Bytes,
  a1: Bytes,
  a2: Bytes,
  a3: Bytes,
  perm_d: Bytes,
  lookup_1: Bytes,
  lookup_2: Bytes,
  perm_a: Bytes,
  perm_b: Bytes,
  perm_c: Bytes,
  perm_input_1: Bytes,
  perm_input_2: Bytes,
  f_commitment: Bytes,
  pi_term: Bytes,
}

// Wrapper used by the `phase2_verify` redeemer.
type Verify {
  reduced_redeemer: ReducedRedeemer,
}

// Redeemer of `phase1_setup`. Carries the proof bytes, the two SNARK
// public inputs, the `phase2` policy id (for the receipt that will be
// minted later) and the recovery timeout.
type Phase1Redeemer {
  proof: Bytes,
  i_1: Bytes,
  i_2: Bytes,
  phase2_policy_id: Bytes,
  reclaim_after: Int,
}

// Type alias used by the Mithril types below.
type String = Bytes;

// ─── Mithril certificate model ──────────────────────────────────────────────
// Mirrors of the upstream Mithril types. Kept here so the on-chain
// validators can authenticate full or reduced Mithril certificates.

// Mithril protocol version tag.
type ProtocolVersion {
  ProtocolVersion {
    value: Bytes,
  },
}

// Mithril STM threshold parameters: `k` quorum size, `m` total slots,
// `phi_f` lottery probability factor.
type ProtocolParameters {
  k: Int,
  m: Int,
  phi_f: Bytes,
}

// One signer in the Mithril stake distribution.
type StakeDistributionParty {
  party_id: Bytes,
  stake: Int,
}

// Per-certificate Mithril metadata (network, protocol version, STM
// parameters, signer set, time bounds).
type CertificateMetadata {
  network: Bytes,
  protocol_version: ProtocolVersion,
  protocol_parameters: ProtocolParameters,
  initiated_at: Bytes,
  sealed_at: Bytes,
  signers: List<StakeDistributionParty>,
}

// Tags identifying entries inside a Mithril `protocol_message`. Each
// tag points to a piece of data the certificate signs.
type ProtocolMessagePartKey {
  SnapshotDigest,
  CardanoTransactionsMerkleRoot,
  NextAggregateVerificationKey,
  NextSnarkAggregateVerificationKey,
  NextProtocolParameters,
  CurrentEpoch,
  LatestBlockNumber,
  CardanoStakeDistributionEpoch,
  CardanoStakeDistributionMerkleRoot,
  CardanoDatabaseMerkleRoot,
}

// The full key/value bag that the Mithril multi-signature signs.
type ProtocolMessage = Map<ProtocolMessagePartKey, String>;

// Discriminates what a Mithril multi-signature is signing — used by
// the bridge to distinguish the three proof domains.
type SignedEntityType {
  MithrilStakeDistribution {
    epoch: Int,
  },
  CardanoStakeDistribution {
    epoch: Int,
  },
  CardanoImmutableFilesFull {
    epoch: Int,
    immutable_file_number: Int,
  },
  CardanoDatabase {
    epoch: Int,
    immutable_file_number: Int,
  },
  CardanoTransactions {
    epoch: Int,
    block_number: Int,
  },
}

// Either a regular multi-signature (with its signed entity type) or
// the bootstrap genesis signature.
type CertificateSignature {
  MultiSignature {
    signed_entity_type: SignedEntityType,
    signature: Bytes,
  },
  GenesisSignature {
    signature: Bytes,
  },
  GenesisDualSignature {
    ed25519_signature: Bytes,
    schnorr_signature: Bytes,
  },
}

// Minimal Groth16 proof container used by the genesis dual-signature path.
type Groth16Proof {
  piA: Bytes,
  piB: Bytes,
  piC: Bytes,
}

// A full Mithril certificate as it appears off-chain.
type MithrilCertificate {
  hash: Bytes,
  prev_hash: Bytes,
  epoch: Int,
  metadata: CertificateMetadata,
  protocol_message: ProtocolMessage,
  signed_message: Bytes,
  aggregate_verification_key: Bytes,
  aggregate_verification_key_snark: Bytes,
  signature: CertificateSignature,
}

// Slimmed-down version of `MithrilCertificate` kept on-chain in
// datums. The full certificate is too big to store, so only the
// fields needed for parent-state chaining and bridge mint validation
// are persisted.
type ReducedMithrilCertificate {
  hash: Bytes,
  prev_hash: Bytes,
  epoch: Int,
  protocol_parameters: ProtocolParameters,
  protocol_message_next_aggregate_verification_key: Bytes,
  protocol_message_next_aggregate_verification_key_snark: Bytes,
  protocol_message_next_protocol_parameters: Bytes,
  protocol_message_current_epoch: Bytes,
  protocol_message_cardano_transactions_merkle_root: Bytes,
  signed_message: Bytes,
  aggregate_verification_key: Bytes,
  aggregate_verification_key_snark: Bytes,
  signed_entity_is_stake_distribution: Bool,
  signed_entity_epoch: Int,
}

// ─── Validator redeemers ────────────────────────────────────────────────────

// Redeemer of the locking-txs updater spending validator. Carries
// the new locking tx info plus the Groth16 proof of the updated
// Merkle root.
type TxsUpdaterValidatorRedeemer {
  tx_id: Bytes,
  locked_assets_utxo_ref_tx_id: Bytes,
  locked_assets_utxo_ref_output_index: Int,
  tx_set_update_proof_pi_a: Bytes,
  tx_set_update_proof_pi_b: Bytes,
  tx_set_update_proof_pi_c: Bytes,
}

// Redeemer of the bridge minting policy. Carries the Mithril
// transactions-snapshot certificate to authenticate, the trusted
// parent certificate state, and the Groth16 proof of inclusion of the
// locking tx in the snapshot. Used by `bridge_mint_tx`.
type MintingValidatorRedeemer {
  tx_snapshot_certificate_hash: Bytes,
  tx_snapshot_certificate_prev_hash: Bytes,
  tx_snapshot_certificate_epoch: Int,
  tx_snapshot_certificate_protocol_parameters_k: Int,
  tx_snapshot_certificate_protocol_parameters_m: Int,
  tx_snapshot_certificate_protocol_parameters_phi_f: Bytes,
  tx_snapshot_certificate_protocol_message_next_aggregate_verification_key: Bytes,
  tx_snapshot_certificate_protocol_message_next_aggregate_verification_key_snark: Bytes,
  tx_snapshot_certificate_protocol_message_next_protocol_parameters: Bytes,
  tx_snapshot_certificate_protocol_message_current_epoch: Bytes,
  tx_snapshot_certificate_protocol_message_cardano_transactions_merkle_root: Bytes,
  tx_snapshot_certificate_signed_message: Bytes,
  tx_snapshot_certificate_aggregate_verification_key: Bytes,
  tx_snapshot_certificate_aggregate_verification_key_snark: Bytes,
  tx_snapshot_certificate_signed_entity_is_stake_distribution: Bool,
  tx_snapshot_certificate_signed_entity_epoch: Int,
  parent_certificate_hash: Bytes,
  parent_certificate_epoch: Int,
  parent_certificate_protocol_parameters_k: Int,
  parent_certificate_protocol_parameters_m: Int,
  parent_certificate_protocol_parameters_phi_f: Bytes,
  parent_certificate_next_aggregate_verification_key_snark: Bytes,
  parent_certificate_aggregate_verification_key_snark: Bytes,
  locking_tx_merkle_proof_public_sub_root: Bytes,
  locking_tx_merkle_proof_pi_a: Bytes,
  locking_tx_merkle_proof_pi_b: Bytes,
  locking_tx_merkle_proof_pi_c: Bytes,
  locking_tx_hash: Bytes,
  locking_tx_input_output_reference_tx_id: Bytes,
  locking_tx_input_output_reference_output_index: Int,
  locking_tx_output_address: Bytes,
  locking_tx_output_lovelace: Int,
  locking_tx_destination_payment_credential: Bytes,
  locking_tx_asset_amount: Int,
  locking_tx_fee: Int,
}

// Redeemer of the stake-distribution minting policy. Carries the new
// Mithril certificate to be added to the chain.
//
// For the experimental dual-genesis path, this also carries:
// - a Groth16 proof of the Jubjub Schnorr half
// - the four runtime-provided Jubjub public inputs that still need large
//   ASCII-decimal transport through Tx3/cshell
// The validator reconstructs the other two public inputs (`digest_hi` and
// `digest_low`) directly from `new_certificate.signed_message`, then checks
// that the response/challenge halves still match
// `GenesisDualSignature.schnorr_signature`.
// Tx3/cshell currently narrows runtime ints to i128, so these four large
// public inputs still travel as ASCII-decimal bytes and the Aiken validator
// decodes them back to on-chain `Int` values before Groth16 verification.
// Prover-supplied data attesting the Jubjub Schnorr half via Groth16: the
// proof plus the four runtime-provided public inputs (still transported as
// ASCII-decimal bytes, see the note above).
type JubjubSchnorrProof {
  proof: Groth16Proof,
  verification_key_u: Bytes,
  verification_key_v: Bytes,
  signature_response: Bytes,
  signature_challenge: Bytes,
}

type StakeDistributionMintRedeemer {
  new_certificate: MithrilCertificate,
  jubjub_schnorr_proof: JubjubSchnorrProof,
}

// Redeemer of the stake-distribution spending validator. Mirrors a
// `ReducedMithrilCertificate` because the spending validator
// re-validates the certificate against the parent state on every
// update.
type StakeDistributionSpendRedeemer {
  hash: Bytes,
  prev_hash: Bytes,
  epoch: Int,
  protocol_parameters: ProtocolParameters,
  protocol_message_next_aggregate_verification_key: Bytes,
  protocol_message_next_aggregate_verification_key_snark: Bytes,
  protocol_message_next_protocol_parameters: Bytes,
  protocol_message_current_epoch: Bytes,
  protocol_message_cardano_transactions_merkle_root: Bytes,
  signed_message: Bytes,
  aggregate_verification_key: Bytes,
  aggregate_verification_key_snark: Bytes,
  signed_entity_is_stake_distribution: Bool,
  signed_entity_epoch: Int,
}

// ─── Datums of the long-lived state UTxOs ───────────────────────────────────

// On-chain projection of the trusted Mithril stake-distribution
// state. Held in the datum of the trusted parent UTxO that
// `bridge_mint_tx` references.
type StakeDistributionCertificateState {
  hash: Bytes,
  epoch: Int,
  protocol_parameters: ProtocolParameters,
  next_aggregate_verification_key: Bytes,
  aggregate_verification_key: Bytes,
  next_aggregate_verification_key_snark: Bytes,
  aggregate_verification_key_snark: Bytes,
}

// Datum of the stake-distribution asset (NFT-bearing) UTxO.
type StakeDistributionAssetDatum {
  certificate: StakeDistributionCertificateState,
}

// Datum of the locking-txs updater UTxO. `merkle_root` accumulates
// every locking tx the bridge has minted against; the empty-set
// genesis value is the all-zeros Merkle root.
type TxsUpdaterDatum {
  merkle_root: Bytes,
}

// ============================================================================
// Transaction templates
// ============================================================================
// What follows are the 12 `tx` templates the bash flow under
// `scripts/` resolves and submits via Dolos. They fall into five
// stages: setup (publish the reference scripts), verification (the
// split phase1 + phase2 SNARK runs, once per Mithril proof domain),
// the stake-distribution chain, the locking-txs updater chain, and
// the bridge mint.

// One-shot setup tx: publishes the `Phase1` validator as a reference
// script so later txs can pull it in via `reference_inputs` instead of
// carrying the script bytes.
tx publish_phase1_reference_script(
  source_utxo: UtxoRef,
  reference_script_lovelace: Int,
) {
  input source {
    ref: source_utxo,
  }

  cardano::publish {
    to: User,
    amount: Ada(reference_script_lovelace),
    version: 3,
    script: ,
  }

  output {
    to: User,
    amount: source - Ada(reference_script_lovelace) - fees,
  }
}

// One-shot setup tx: publishes the `LockingTxsUpdaterSpend` validator
// as a reference script.
tx publish_minting_txs_updater_spend_reference_script(
  reference_script_lovelace: Int,
  source_utxo: UtxoRef,
) {
  input source {
    from: User,
    ref: source_utxo,
    min_amount: Ada(reference_script_lovelace) + fees,
  }

  cardano::publish {
    to: User,
    amount: Ada(reference_script_lovelace),
    version: 3,
    script: ,
  }

  output {
    to: User,
    amount: source - Ada(reference_script_lovelace) - fees,
  }
}

// One-shot setup tx: publishes the `BridgeMinting` validator as a
// reference script. `bridge_mint_tx` pulls this UTxO in instead of
// inlining the (very large) verifier script bytes.
tx publish_bridge_minting_reference_script(
  reference_script_lovelace: Int,
  source_utxo: UtxoRef,
) {
  input source {
    from: User,
    ref: source_utxo,
    min_amount: Ada(reference_script_lovelace) + fees,
  }

  cardano::publish {
    to: User,
    amount: Ada(reference_script_lovelace),
    version: 3,
    script: ,
  }

  output {
    to: User,
    amount: source - Ada(reference_script_lovelace) - fees,
  }
}

// First half of the split SNARK verification. Writes a `Phase1State`
// datum to a UTxO under the `Phase1` validator with the cheap-side
// cryptographic state (transcript challenges, commitments). Run once
// per Mithril proof domain (`sd_genesis`, `sd_standard`,
// `cardano_transactions`).
tx phase1_setup(
  source_utxo: UtxoRef,
  proof_bytes: Bytes,
  public_input_1: Bytes,
  public_input_2: Bytes,
  phase1_state_rhs_prefix: Bytes,
  phase1_state_reduced_hash: Bytes,
  phase1_state_x1: Bytes,
  phase1_state_x3: Bytes,
  phase1_state_x4: Bytes,
  phase1_state_v: Bytes,
  phase1_signer_vkh: Bytes,
  reclaim_after_ms: Int,
  statement_hash_value: Bytes,
  phase2_output_lovelace: Int,
  phase1_reference_script_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
) {
  locals {
    // The phase1 validator binds the minted NFT asset name to the
    // proof-derived reduced_hash.
    phase1_nft: AnyAsset(0x68e200e78f684e2a848be807370db9a7ff773575982cafc2457012f9, phase1_state_reduced_hash, 1),
    phase2_output_ada: Ada(phase2_output_lovelace),
    phase1_state_value: Phase1State {
      rhs_prefix: phase1_state_rhs_prefix,
      reduced_hash: phase1_state_reduced_hash,
      x1: phase1_state_x1,
      x3: phase1_state_x3,
      x4: phase1_state_x4,
      v: phase1_state_v,
    },
  }

  input source {
    ref: source_utxo,
  }

  reference phase1_reference_script {
    ref: phase1_reference_script_utxo,
  }

  collateral {
    ref: collateral_utxo,
  }

  mint {
    amount: phase1_nft,
    redeemer: Phase1Redeemer {
      proof: proof_bytes,
      i_1: public_input_1,
      i_2: public_input_2,
      phase2_policy_id: 0x2694be01c9fefd6ce78b5664f7e31aca5c364e7abaa68a0ea640be63,
      reclaim_after: reclaim_after_ms,
    },
  }

  output {
    to: Phase2,
    amount: phase2_output_ada + phase1_nft,
    datum: Phase2State {
      proof_state: phase1_state_value,
      phase1_signer: phase1_signer_vkh,
      reclaim_after: reclaim_after_ms,
      statement_hash: statement_hash_value,
    },
  }

  output {
    to: User,
    amount: source - phase2_output_ada - fees,
  }

  // Tx3 maps this block to Cardano required_signers, which phase1 reads back
  // on-chain as transaction.extra_signatories.
  signers {
    User,
  }

}

// Second half of the split SNARK verification. Consumes the
// `Phase1State` UTxO produced by `phase1_setup`, runs the expensive
// pairing check, and on success produces a `proof_receipt` UTxO
// carrying an NFT bound to the verified `statement_hash`. Run once
// per Mithril proof domain.
tx phase2_verify(
  token_name: Bytes,
  locked_lovelace: Int,
  receipt_lovelace: Int,
  collateral_lovelace: Int,
  proof_receipt_statement_hash: Bytes,
  source_utxo: UtxoRef,
  phase2_locked_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
  reduced_redeemer_vanishing_g: Bytes,
  reduced_redeemer_vanishing_rand: Bytes,
  reduced_redeemer_a1: Bytes,
  reduced_redeemer_a2: Bytes,
  reduced_redeemer_a3: Bytes,
  reduced_redeemer_perm_d: Bytes,
  reduced_redeemer_lookup_1: Bytes,
  reduced_redeemer_lookup_2: Bytes,
  reduced_redeemer_perm_a: Bytes,
  reduced_redeemer_perm_b: Bytes,
  reduced_redeemer_perm_c: Bytes,
  reduced_redeemer_perm_input_1: Bytes,
  reduced_redeemer_perm_input_2: Bytes,
  reduced_redeemer_f_commitment: Bytes,
  reduced_redeemer_pi_term: Bytes,
) {
  locals {
    phase1_nft: AnyAsset(0x68e200e78f684e2a848be807370db9a7ff773575982cafc2457012f9, token_name, 1),
    phase2_nft: AnyAsset(0x2694be01c9fefd6ce78b5664f7e31aca5c364e7abaa68a0ea640be63, token_name, 1),
    locked_value: Ada(locked_lovelace) + phase1_nft,
    receipt_value: Ada(receipt_lovelace) + phase2_nft,
    reduced_redeemer_value: ReducedRedeemer {
      vanishing_g: reduced_redeemer_vanishing_g,
      vanishing_rand: reduced_redeemer_vanishing_rand,
      a1: reduced_redeemer_a1,
      a2: reduced_redeemer_a2,
      a3: reduced_redeemer_a3,
      perm_d: reduced_redeemer_perm_d,
      lookup_1: reduced_redeemer_lookup_1,
      lookup_2: reduced_redeemer_lookup_2,
      perm_a: reduced_redeemer_perm_a,
      perm_b: reduced_redeemer_perm_b,
      perm_c: reduced_redeemer_perm_c,
      perm_input_1: reduced_redeemer_perm_input_1,
      perm_input_2: reduced_redeemer_perm_input_2,
      f_commitment: reduced_redeemer_f_commitment,
      pi_term: reduced_redeemer_pi_term,
    },
  }

  input phase2_locked {
    from: Phase2,
    ref: phase2_locked_utxo,
    min_amount: locked_value,
    redeemer: Verify {
      reduced_redeemer: reduced_redeemer_value,
    },
  }

  input source {
    ref: source_utxo,
  }

  collateral {
    ref: collateral_utxo,
  }

  mint {
    amount: phase2_nft,
    redeemer: token_name,
  }

  output {
    to: ProofReceipt,
    amount: receipt_value,
    datum: ProofReceiptDatum {
      statement_hash: proof_receipt_statement_hash,
    },
  }

  output {
    to: User,
    amount: phase2_locked + source - Ada(receipt_lovelace) - fees,
  }

  signers {
    User,
  }

  // Reuse the phase2 script both as spending validator and minting policy.
  // This inline witness is the compiled `phase2.phase2.spend` /
  // `phase2.phase2.mint` script currently synced into `main.tx3`.
  cardano::plutus_witness {
    version: 3,
    script: ,
  }
}

// First link of the trusted stake-distribution chain for the legacy Mithril
// genesis certificate path. Emits the genesis stake-distribution UTxO that
// `stake_distribution_standard_tx` will chain against.
tx stake_distribution_genesis_tx(
  certificate_hash: Bytes,
  certificate_prev_hash: Bytes,
  certificate_epoch: Int,
  certificate_network: Bytes,
  certificate_protocol_version: Bytes,
  certificate_protocol_parameters_k: Int,
  certificate_protocol_parameters_m: Int,
  certificate_protocol_parameters_phi_f: Bytes,
  certificate_initiated_at: Bytes,
  certificate_sealed_at: Bytes,
  certificate_protocol_message_next_aggregate_verification_key: Bytes,
  certificate_protocol_message_next_aggregate_verification_key_snark: Bytes,
  certificate_protocol_message_next_protocol_parameters: Bytes,
  certificate_protocol_message_current_epoch: Bytes,
  certificate_signed_message: Bytes,
  certificate_aggregate_verification_key: Bytes,
  certificate_aggregate_verification_key_snark: Bytes,
  certificate_signature: Bytes,
  stake_distribution_output_lovelace: Int,
  source_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
) {
  locals {
    stake_distribution_nft: StakeDistributionNFT(1),
    stake_distribution_output_ada: Ada(stake_distribution_output_lovelace),
    new_certificate_value: MithrilCertificate {
      hash: certificate_hash,
      prev_hash: certificate_prev_hash,
      epoch: certificate_epoch,
      metadata: CertificateMetadata {
        network: certificate_network,
        protocol_version: ProtocolVersion::ProtocolVersion {
          value: certificate_protocol_version,
        },
        protocol_parameters: ProtocolParameters {
          k: certificate_protocol_parameters_k,
          m: certificate_protocol_parameters_m,
          phi_f: certificate_protocol_parameters_phi_f,
        },
        initiated_at: certificate_initiated_at,
        sealed_at: certificate_sealed_at,
        // Tx3 args are primitive-only, so we keep signers flat-free for now.
        signers: [],
      },
      protocol_message: {
        ProtocolMessagePartKey::NextAggregateVerificationKey {}:
          certificate_protocol_message_next_aggregate_verification_key,
        ProtocolMessagePartKey::NextSnarkAggregateVerificationKey {}:
          certificate_protocol_message_next_aggregate_verification_key_snark,
        ProtocolMessagePartKey::NextProtocolParameters {}:
          certificate_protocol_message_next_protocol_parameters,
        ProtocolMessagePartKey::CurrentEpoch {}:
          certificate_protocol_message_current_epoch,
      },
      signed_message: certificate_signed_message,
      aggregate_verification_key: certificate_aggregate_verification_key,
      aggregate_verification_key_snark:
        certificate_aggregate_verification_key_snark,
      signature: CertificateSignature::GenesisSignature {
        signature: certificate_signature,
      },
    },
    new_certificate_state: StakeDistributionCertificateState {
      hash: certificate_hash,
      epoch: certificate_epoch,
      protocol_parameters: ProtocolParameters {
        k: certificate_protocol_parameters_k,
        m: certificate_protocol_parameters_m,
        phi_f: certificate_protocol_parameters_phi_f,
      },
      next_aggregate_verification_key:
        certificate_protocol_message_next_aggregate_verification_key,
      aggregate_verification_key: certificate_aggregate_verification_key,
      next_aggregate_verification_key_snark:
        certificate_protocol_message_next_aggregate_verification_key_snark,
      aggregate_verification_key_snark:
        certificate_aggregate_verification_key_snark,
    },
    legacy_unused_jubjub_schnorr_proof: Groth16Proof {
      piA: 0x00,
      piB: 0x00,
      piC: 0x00,
    },
  }

  input source {
    from: User,
    ref: source_utxo,
    min_amount: stake_distribution_output_ada + Ada(10000001) + fees,
  }

  collateral {
    ref: collateral_utxo,
  }

  mint {
    amount: stake_distribution_nft,
    redeemer: StakeDistributionMintRedeemer {
      new_certificate: new_certificate_value,
      jubjub_schnorr_proof: JubjubSchnorrProof {
        proof: legacy_unused_jubjub_schnorr_proof,
        verification_key_u: 0x30,
        verification_key_v: 0x30,
        signature_response: 0x30,
        signature_challenge: 0x30,
      },
    },
  }

  output {
    to: StakeDistributionSpend,
    amount: stake_distribution_output_ada + stake_distribution_nft,
    datum: StakeDistributionAssetDatum {
      certificate: new_certificate_state,
    },
  }

  output {
    to: User,
    amount: source - stake_distribution_output_ada - fees,
  }

  cardano::plutus_witness {
    version: 3,
    script: ,
  }

}

// First link of the trusted stake-distribution chain for the experimental
// dual-signature Mithril genesis certificate path.
tx stake_distribution_dual_genesis_tx(
  certificate_hash: Bytes,
  certificate_prev_hash: Bytes,
  certificate_epoch: Int,
  certificate_network: Bytes,
  certificate_protocol_version: Bytes,
  certificate_protocol_parameters_k: Int,
  certificate_protocol_parameters_m: Int,
  certificate_protocol_parameters_phi_f: Bytes,
  certificate_initiated_at: Bytes,
  certificate_sealed_at: Bytes,
  certificate_protocol_message_next_aggregate_verification_key: Bytes,
  certificate_protocol_message_next_aggregate_verification_key_snark: Bytes,
  certificate_protocol_message_next_protocol_parameters: Bytes,
  certificate_protocol_message_current_epoch: Bytes,
  certificate_signed_message: Bytes,
  certificate_aggregate_verification_key: Bytes,
  certificate_aggregate_verification_key_snark: Bytes,
  certificate_ed25519_signature: Bytes,
  certificate_schnorr_signature: Bytes,
  jubjub_schnorr_proof_pi_a: Bytes,
  jubjub_schnorr_proof_pi_b: Bytes,
  jubjub_schnorr_proof_pi_c: Bytes,
  dual_jubjub_schnorr_verification_key_u: Bytes,
  dual_jubjub_schnorr_verification_key_v: Bytes,
  dual_jubjub_schnorr_signature_response: Bytes,
  dual_jubjub_schnorr_signature_challenge: Bytes,
  stake_distribution_output_lovelace: Int,
  source_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
) {
  locals {
    stake_distribution_nft: StakeDistributionNFT(1),
    stake_distribution_output_ada: Ada(stake_distribution_output_lovelace),
    new_certificate_value: MithrilCertificate {
      hash: certificate_hash,
      prev_hash: certificate_prev_hash,
      epoch: certificate_epoch,
      metadata: CertificateMetadata {
        network: certificate_network,
        protocol_version: ProtocolVersion::ProtocolVersion {
          value: certificate_protocol_version,
        },
        protocol_parameters: ProtocolParameters {
          k: certificate_protocol_parameters_k,
          m: certificate_protocol_parameters_m,
          phi_f: certificate_protocol_parameters_phi_f,
        },
        initiated_at: certificate_initiated_at,
        sealed_at: certificate_sealed_at,
        // Tx3 args are primitive-only, so we keep signers flat-free for now.
        signers: [],
      },
      protocol_message: {
        ProtocolMessagePartKey::NextAggregateVerificationKey {}:
          certificate_protocol_message_next_aggregate_verification_key,
        ProtocolMessagePartKey::NextSnarkAggregateVerificationKey {}:
          certificate_protocol_message_next_aggregate_verification_key_snark,
        ProtocolMessagePartKey::NextProtocolParameters {}:
          certificate_protocol_message_next_protocol_parameters,
        ProtocolMessagePartKey::CurrentEpoch {}:
          certificate_protocol_message_current_epoch,
      },
      signed_message: certificate_signed_message,
      aggregate_verification_key: certificate_aggregate_verification_key,
      aggregate_verification_key_snark:
        certificate_aggregate_verification_key_snark,
      signature: CertificateSignature::GenesisDualSignature {
        ed25519_signature: certificate_ed25519_signature,
        schnorr_signature: certificate_schnorr_signature,
      },
    },
    new_certificate_state: StakeDistributionCertificateState {
      hash: certificate_hash,
      epoch: certificate_epoch,
      protocol_parameters: ProtocolParameters {
        k: certificate_protocol_parameters_k,
        m: certificate_protocol_parameters_m,
        phi_f: certificate_protocol_parameters_phi_f,
      },
      next_aggregate_verification_key:
        certificate_protocol_message_next_aggregate_verification_key,
      aggregate_verification_key: certificate_aggregate_verification_key,
      next_aggregate_verification_key_snark:
        certificate_protocol_message_next_aggregate_verification_key_snark,
      aggregate_verification_key_snark:
        certificate_aggregate_verification_key_snark,
    },
    jubjub_schnorr_proof_value: Groth16Proof {
      piA: jubjub_schnorr_proof_pi_a,
      piB: jubjub_schnorr_proof_pi_b,
      piC: jubjub_schnorr_proof_pi_c,
    },
  }

  input source {
    from: User,
    ref: source_utxo,
    min_amount: stake_distribution_output_ada + Ada(10000001) + fees,
  }

  collateral {
    ref: collateral_utxo,
  }

  mint {
    amount: stake_distribution_nft,
    redeemer: StakeDistributionMintRedeemer {
      new_certificate: new_certificate_value,
      jubjub_schnorr_proof: JubjubSchnorrProof {
        proof: jubjub_schnorr_proof_value,
        verification_key_u: dual_jubjub_schnorr_verification_key_u,
        verification_key_v: dual_jubjub_schnorr_verification_key_v,
        signature_response: dual_jubjub_schnorr_signature_response,
        signature_challenge: dual_jubjub_schnorr_signature_challenge,
      },
    },
  }

  output {
    to: StakeDistributionSpend,
    amount: stake_distribution_output_ada + stake_distribution_nft,
    datum: StakeDistributionAssetDatum {
      certificate: new_certificate_state,
    },
  }

  output {
    to: User,
    amount: source - stake_distribution_output_ada - fees,
  }

  cardano::plutus_witness {
    version: 3,
    script: ,
  }

}

// Updates the trusted stake-distribution state. Consumes the
// `sd_standard` proof_receipt plus the previous parent UTxO, and
// emits the `sdstate` UTxO that `bridge_mint_tx` references as a
// reference input.
tx stake_distribution_standard_tx(
  certificate_hash: Bytes,
  certificate_prev_hash: Bytes,
  certificate_epoch: Int,
  certificate_protocol_parameters_k: Int,
  certificate_protocol_parameters_m: Int,
  certificate_protocol_parameters_phi_f: Bytes,
  certificate_protocol_message_next_aggregate_verification_key: Bytes,
  certificate_protocol_message_next_aggregate_verification_key_snark: Bytes,
  certificate_protocol_message_next_protocol_parameters: Bytes,
  certificate_protocol_message_current_epoch: Bytes,
  certificate_protocol_message_cardano_transactions_merkle_root: Bytes,
  certificate_signed_message: Bytes,
  certificate_aggregate_verification_key: Bytes,
  certificate_aggregate_verification_key_snark: Bytes,
  certificate_signed_entity_is_stake_distribution: Bool,
  certificate_signed_entity_epoch: Int,
  parent_certificate_lovelace: Int,
  source_utxo: UtxoRef,
  sd_standard_receipt_utxo: UtxoRef,
  parent_certificate_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
) {
  locals {
    stake_distribution_nft: StakeDistributionNFT(1),
    parent_certificate_ada: Ada(parent_certificate_lovelace),
    new_certificate_redeemer: StakeDistributionSpendRedeemer {
      hash: certificate_hash,
      prev_hash: certificate_prev_hash,
      epoch: certificate_epoch,
      protocol_parameters: ProtocolParameters {
        k: certificate_protocol_parameters_k,
        m: certificate_protocol_parameters_m,
        phi_f: certificate_protocol_parameters_phi_f,
      },
      protocol_message_next_aggregate_verification_key:
        certificate_protocol_message_next_aggregate_verification_key,
      protocol_message_next_aggregate_verification_key_snark:
        certificate_protocol_message_next_aggregate_verification_key_snark,
      protocol_message_next_protocol_parameters:
        certificate_protocol_message_next_protocol_parameters,
      protocol_message_current_epoch:
        certificate_protocol_message_current_epoch,
      protocol_message_cardano_transactions_merkle_root:
        certificate_protocol_message_cardano_transactions_merkle_root,
      signed_message: certificate_signed_message,
      aggregate_verification_key: certificate_aggregate_verification_key,
      aggregate_verification_key_snark:
        certificate_aggregate_verification_key_snark,
      signed_entity_is_stake_distribution:
        certificate_signed_entity_is_stake_distribution,
      signed_entity_epoch: certificate_signed_entity_epoch,
    },
    new_certificate_state: StakeDistributionCertificateState {
      hash: certificate_hash,
      epoch: certificate_epoch,
      protocol_parameters: ProtocolParameters {
        k: certificate_protocol_parameters_k,
        m: certificate_protocol_parameters_m,
        phi_f: certificate_protocol_parameters_phi_f,
      },
      next_aggregate_verification_key:
        certificate_protocol_message_next_aggregate_verification_key,
      aggregate_verification_key: certificate_aggregate_verification_key,
      next_aggregate_verification_key_snark:
        certificate_protocol_message_next_aggregate_verification_key_snark,
      aggregate_verification_key_snark:
        certificate_aggregate_verification_key_snark,
    },
  }

  input parent_certificate_input {
    from: StakeDistributionSpend,
    ref: parent_certificate_utxo,
    redeemer: new_certificate_redeemer,
  }

  input source {
    from: User,
    ref: source_utxo,
    min_amount: Ada(10000001) + fees,
  }

  collateral {
    ref: collateral_utxo,
  }

  input sd_standard_receipt {
    from: ProofReceipt,
    ref: sd_standard_receipt_utxo,
    redeemer: 0,
  }

  output {
    to: StakeDistributionSpend,
    amount: parent_certificate_ada + stake_distribution_nft,
    datum: StakeDistributionAssetDatum {
      certificate: new_certificate_state,
    },
  }

  output {
    to: User,
    amount: source + sd_standard_receipt - fees,
  }

  cardano::plutus_witness {
    version: 3,
    script: ,
  }

  cardano::plutus_witness {
    version: 3,
    script: 0x585d01010029800aba2aba1aab9eaab9dab9a4888896600264646644b30013370e900118031baa0028994c004c02400660126014003375a601200891125118039baa0028b200a30063007001300600230060013003375400d149a26cac8009,
  }

}

// Prepares the one-shot anchor UTxO that
// `minting_txs_updater_seed_tx` will consume as its
// `unique_mint_source`. This is what makes the
// `LockingTxsUpdaterMint` policy mintable exactly once: the genesis
// tx must spend this specific UTxO, and once spent it cannot be
// replayed.
tx locking_txs_updater_seed_tx(
  seed_output_lovelace: Int,
  source_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
) {
  locals {
    seed_output_ada: Ada(seed_output_lovelace),
  }

  input source {
    from: User,
    ref: source_utxo,
    min_amount: seed_output_ada + fees,
  }

  collateral {
    ref: collateral_utxo,
  }

  output {
    to: User,
    amount: seed_output_ada,
  }

  output {
    to: User,
    amount: source - seed_output_ada - fees,
  }
}

// Genesis of the locking-txs updater chain. Spends the seed UTxO,
// mints the `LockingTxsUpdaterNFT`, and produces the genesis updater
// UTxO at `LockingTxsUpdaterSpend` with `merkle_root: empty_merkle_root`
// (no locking txs minted yet). This is the UTxO consumed by
// `bridge_mint_tx`.
tx minting_txs_updater_seed_tx(
  locking_txs_updater_output_lovelace: Int,
  bridge_collateral_lovelace: Int,
  unique_mint_source_utxo: UtxoRef,
  source_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
) {
  locals {
    locking_txs_updater_nft: LockingTxsUpdaterNFT(1),
    locking_txs_updater_output_ada: Ada(locking_txs_updater_output_lovelace),
    bridge_collateral_ada: Ada(bridge_collateral_lovelace),
    empty_merkle_root: 0x1081218ce61ee106396796dc2b469a63b99a934125107c4cc30050966f39b130,
  }

  input source {
    from: User,
    ref: source_utxo,
    min_amount:
      locking_txs_updater_output_ada + bridge_collateral_ada + Ada(10000001) + fees,
  }

  input unique_mint_source {
    ref: unique_mint_source_utxo,
  }

  collateral {
    ref: collateral_utxo,
  }

  mint {
    amount: locking_txs_updater_nft,
    redeemer: (),
  }

  output {
    to: LockingTxsUpdaterSpend,
    amount: locking_txs_updater_output_ada + locking_txs_updater_nft,
    datum: TxsUpdaterDatum {
      merkle_root: empty_merkle_root,
    },
  }

  output {
    to: User,
    amount: bridge_collateral_ada,
  }

  output {
    to: User,
    amount:
      source + unique_mint_source - locking_txs_updater_output_ada - bridge_collateral_ada - fees,
  }

  cardano::plutus_witness {
    version: 3,
    script: ,
  }
}

// Test/fixture helper. Seeds a UTxO whose datum carries a hardcoded
// parent stake-distribution state, so the bridge mint flow can be
// exercised without first running the full stake-distribution chain
// end-to-end. The hash, epoch, AVKs and protocol parameters are
// inlined as constants.
tx bridge_parent_certificate_reference_tx(
  collateral_utxo: UtxoRef,
) {
  locals {
    parent_certificate_output_ada: Ada(3000000),
    parent_certificate_state: StakeDistributionCertificateState {
      hash: 0x00a5e9ef826387c595d2e7cff950cf0a995546afc67d3c3ca8583e2c11496606,
      epoch: 1150,
      protocol_parameters: ProtocolParameters {
        k: 5,
        m: 100,
        phi_f: 0x00a66666,
      },
      next_aggregate_verification_key:
        0x6272696467652d706172656e742d6e6578742d61766b,
      aggregate_verification_key:
        0x6272696467652d706172656e742d61766b,
      next_aggregate_verification_key_snark: 0x736e61726b2d61766b2d31313530,
      aggregate_verification_key_snark: 0x736e61726b2d61766b2d31313530,
    },
  }

  input source {
    from: User,
    min_amount: parent_certificate_output_ada + fees,
  }

  collateral {
    ref: collateral_utxo,
  }

  output {
    to: User,
    amount: parent_certificate_output_ada,
    datum: StakeDistributionAssetDatum {
      certificate: parent_certificate_state,
    },
  }

  output {
    to: User,
    amount: source - parent_certificate_output_ada - fees,
  }
}

// The final transaction of the bridge flow. Mints the wrapped tokens
// (`BridgedAsset`). Consumes the `cardano_transactions` proof_receipt
// and the locking-txs updater UTxO; references `sdstate` as a
// reference input and the `BridgeMinting` reference script. The
// `BridgeMinting` validator checks the Mithril certificate against
// the trusted parent and verifies the Groth16 inclusion proof of the
// locking tx in the snapshot.
tx bridge_mint_tx(
  locking_txs_updater_utxo: UtxoRef,
  source_utxo: UtxoRef,
  stake_distribution_utxo: UtxoRef,
  tx_snapshot_receipt_utxo: UtxoRef,
  locking_txs_updater_spend_reference_script_utxo: UtxoRef,
  bridge_minting_reference_script_utxo: UtxoRef,
  collateral_utxo: UtxoRef,
  bridge_asset_amount: Int,
  bridge_output_lovelace: Int,
  locking_txs_updater_output_lovelace: Int,
  new_merkle_root: Bytes,
  tx_snapshot_certificate_hash: Bytes,
  tx_snapshot_certificate_prev_hash: Bytes,
  tx_snapshot_certificate_epoch: Int,
  tx_snapshot_certificate_protocol_parameters_k: Int,
  tx_snapshot_certificate_protocol_parameters_m: Int,
  tx_snapshot_certificate_protocol_parameters_phi_f: Bytes,
  tx_snapshot_certificate_protocol_message_next_aggregate_verification_key: Bytes,
  tx_snapshot_certificate_protocol_message_next_aggregate_verification_key_snark: Bytes,
  tx_snapshot_certificate_protocol_message_next_protocol_parameters: Bytes,
  tx_snapshot_certificate_protocol_message_current_epoch: Bytes,
  tx_snapshot_certificate_protocol_message_cardano_transactions_merkle_root: Bytes,
  tx_snapshot_certificate_signed_message: Bytes,
  tx_snapshot_certificate_aggregate_verification_key: Bytes,
  tx_snapshot_certificate_aggregate_verification_key_snark: Bytes,
  tx_snapshot_certificate_signed_entity_is_stake_distribution: Bool,
  tx_snapshot_certificate_signed_entity_epoch: Int,
  parent_certificate_hash: Bytes,
  parent_certificate_epoch: Int,
  parent_certificate_protocol_parameters_k: Int,
  parent_certificate_protocol_parameters_m: Int,
  parent_certificate_protocol_parameters_phi_f: Bytes,
  parent_certificate_next_aggregate_verification_key_snark: Bytes,
  parent_certificate_aggregate_verification_key_snark: Bytes,
  locking_tx_merkle_proof_public_sub_root: Bytes,
  locking_tx_merkle_proof_pi_a: Bytes,
  locking_tx_merkle_proof_pi_b: Bytes,
  locking_tx_merkle_proof_pi_c: Bytes,
  locking_tx_hash: Bytes,
  locking_tx_input_output_reference_tx_id: Bytes,
  locking_tx_input_output_reference_output_index: Int,
  locking_tx_output_address: Bytes,
  locking_tx_output_lovelace: Int,
  locking_tx_destination_payment_credential: Bytes,
  locking_tx_asset_amount: Int,
  locking_tx_fee: Int,
  tx_set_update_proof_pi_a: Bytes,
  tx_set_update_proof_pi_b: Bytes,
  tx_set_update_proof_pi_c: Bytes,
) {
  locals {
    bridge_output_ada: Ada(bridge_output_lovelace),
    bridge_asset_value: bridge_output_ada + BridgedAsset(bridge_asset_amount),
    locking_txs_updater_nft: LockingTxsUpdaterNFT(1),
    locking_txs_updater_output_value:
      Ada(locking_txs_updater_output_lovelace) + locking_txs_updater_nft,
    bridge_tx_snapshot_certificate_hash: tx_snapshot_certificate_hash,
    bridge_tx_snapshot_certificate_prev_hash:
      tx_snapshot_certificate_prev_hash,
    bridge_tx_snapshot_certificate_epoch: tx_snapshot_certificate_epoch,
    bridge_tx_snapshot_certificate_protocol_parameters_k:
      tx_snapshot_certificate_protocol_parameters_k,
    bridge_tx_snapshot_certificate_protocol_parameters_m:
      tx_snapshot_certificate_protocol_parameters_m,
    bridge_tx_snapshot_certificate_protocol_parameters_phi_f:
      tx_snapshot_certificate_protocol_parameters_phi_f,
    bridge_tx_snapshot_certificate_protocol_message_next_aggregate_verification_key:
      tx_snapshot_certificate_protocol_message_next_aggregate_verification_key,
    bridge_tx_snapshot_certificate_protocol_message_next_aggregate_verification_key_snark:
      tx_snapshot_certificate_protocol_message_next_aggregate_verification_key_snark,
    bridge_tx_snapshot_certificate_protocol_message_next_protocol_parameters:
      tx_snapshot_certificate_protocol_message_next_protocol_parameters,
    bridge_tx_snapshot_certificate_protocol_message_current_epoch:
      tx_snapshot_certificate_protocol_message_current_epoch,
    bridge_tx_snapshot_certificate_protocol_message_cardano_transactions_merkle_root:
      tx_snapshot_certificate_protocol_message_cardano_transactions_merkle_root,
    bridge_tx_snapshot_certificate_signed_message:
      tx_snapshot_certificate_signed_message,
    bridge_tx_snapshot_certificate_aggregate_verification_key:
      tx_snapshot_certificate_aggregate_verification_key,
    bridge_tx_snapshot_certificate_aggregate_verification_key_snark:
      tx_snapshot_certificate_aggregate_verification_key_snark,
    bridge_tx_snapshot_certificate_signed_entity_is_stake_distribution:
      tx_snapshot_certificate_signed_entity_is_stake_distribution,
    bridge_tx_snapshot_certificate_signed_entity_epoch:
      tx_snapshot_certificate_signed_entity_epoch,
    bridge_parent_certificate_hash: parent_certificate_hash,
    bridge_parent_certificate_epoch: parent_certificate_epoch,
    bridge_parent_certificate_protocol_parameters_k:
      parent_certificate_protocol_parameters_k,
    bridge_parent_certificate_protocol_parameters_m:
      parent_certificate_protocol_parameters_m,
    bridge_parent_certificate_protocol_parameters_phi_f:
      parent_certificate_protocol_parameters_phi_f,
    bridge_parent_certificate_next_aggregate_verification_key_snark:
      parent_certificate_next_aggregate_verification_key_snark,
    bridge_parent_certificate_aggregate_verification_key_snark:
      parent_certificate_aggregate_verification_key_snark,
    bridge_locking_tx_merkle_proof_public_sub_root:
      locking_tx_merkle_proof_public_sub_root,
    bridge_locking_tx_merkle_proof_pi_a: locking_tx_merkle_proof_pi_a,
    bridge_locking_tx_merkle_proof_pi_b: locking_tx_merkle_proof_pi_b,
    bridge_locking_tx_merkle_proof_pi_c: locking_tx_merkle_proof_pi_c,
    bridge_locking_tx_hash: locking_tx_hash,
    bridge_locking_tx_input_output_reference_tx_id:
      locking_tx_input_output_reference_tx_id,
    bridge_locking_tx_input_output_reference_output_index:
      locking_tx_input_output_reference_output_index,
    bridge_locking_tx_output_address: locking_tx_output_address,
    bridge_locking_tx_output_lovelace: locking_tx_output_lovelace,
    bridge_locking_tx_destination_payment_credential:
      locking_tx_destination_payment_credential,
    bridge_locking_tx_asset_amount: locking_tx_asset_amount,
    bridge_locking_tx_fee: locking_tx_fee,
    bridge_tx_set_update_proof_pi_a: tx_set_update_proof_pi_a,
    bridge_tx_set_update_proof_pi_b: tx_set_update_proof_pi_b,
    bridge_tx_set_update_proof_pi_c: tx_set_update_proof_pi_c,
  }

  input locking_txs_updater_input {
    from: LockingTxsUpdaterSpend,
    ref: locking_txs_updater_utxo,
    datum_is: TxsUpdaterDatum,
    redeemer: TxsUpdaterValidatorRedeemer {
      tx_id: bridge_locking_tx_hash,
      locked_assets_utxo_ref_tx_id:
        bridge_locking_tx_input_output_reference_tx_id,
      locked_assets_utxo_ref_output_index:
        bridge_locking_tx_input_output_reference_output_index,
      tx_set_update_proof_pi_a: bridge_tx_set_update_proof_pi_a,
      tx_set_update_proof_pi_b: bridge_tx_set_update_proof_pi_b,
      tx_set_update_proof_pi_c: bridge_tx_set_update_proof_pi_c,
    },
  }

  input source {
    from: User,
    ref: source_utxo,
  }

  collateral {
    ref: collateral_utxo,
  }

  reference stake_distribution_input {
    ref: stake_distribution_utxo,
  }

  input tx_snapshot_receipt {
    from: ProofReceipt,
    ref: tx_snapshot_receipt_utxo,
    redeemer: 0,
  }

  reference locking_txs_updater_spend_reference_script {
    ref: locking_txs_updater_spend_reference_script_utxo,
  }

  reference bridge_minting_reference_script {
    ref: bridge_minting_reference_script_utxo,
  }

  mint {
    amount: BridgedAsset(bridge_asset_amount),
    redeemer: MintingValidatorRedeemer {
      tx_snapshot_certificate_hash: bridge_tx_snapshot_certificate_hash,
      tx_snapshot_certificate_prev_hash:
        bridge_tx_snapshot_certificate_prev_hash,
      tx_snapshot_certificate_epoch: bridge_tx_snapshot_certificate_epoch,
      tx_snapshot_certificate_protocol_parameters_k:
        bridge_tx_snapshot_certificate_protocol_parameters_k,
      tx_snapshot_certificate_protocol_parameters_m:
        bridge_tx_snapshot_certificate_protocol_parameters_m,
      tx_snapshot_certificate_protocol_parameters_phi_f:
        bridge_tx_snapshot_certificate_protocol_parameters_phi_f,
      tx_snapshot_certificate_protocol_message_next_aggregate_verification_key:
        bridge_tx_snapshot_certificate_protocol_message_next_aggregate_verification_key,
      tx_snapshot_certificate_protocol_message_next_aggregate_verification_key_snark:
        bridge_tx_snapshot_certificate_protocol_message_next_aggregate_verification_key_snark,
      tx_snapshot_certificate_protocol_message_next_protocol_parameters:
        bridge_tx_snapshot_certificate_protocol_message_next_protocol_parameters,
      tx_snapshot_certificate_protocol_message_current_epoch:
        bridge_tx_snapshot_certificate_protocol_message_current_epoch,
      tx_snapshot_certificate_protocol_message_cardano_transactions_merkle_root:
        bridge_tx_snapshot_certificate_protocol_message_cardano_transactions_merkle_root,
      tx_snapshot_certificate_signed_message:
        bridge_tx_snapshot_certificate_signed_message,
      tx_snapshot_certificate_aggregate_verification_key:
        bridge_tx_snapshot_certificate_aggregate_verification_key,
      tx_snapshot_certificate_aggregate_verification_key_snark:
        bridge_tx_snapshot_certificate_aggregate_verification_key_snark,
      tx_snapshot_certificate_signed_entity_is_stake_distribution:
        bridge_tx_snapshot_certificate_signed_entity_is_stake_distribution,
      tx_snapshot_certificate_signed_entity_epoch:
        bridge_tx_snapshot_certificate_signed_entity_epoch,
      parent_certificate_hash: bridge_parent_certificate_hash,
      parent_certificate_epoch: bridge_parent_certificate_epoch,
      parent_certificate_protocol_parameters_k:
        bridge_parent_certificate_protocol_parameters_k,
      parent_certificate_protocol_parameters_m:
        bridge_parent_certificate_protocol_parameters_m,
      parent_certificate_protocol_parameters_phi_f:
        bridge_parent_certificate_protocol_parameters_phi_f,
      parent_certificate_next_aggregate_verification_key_snark:
        bridge_parent_certificate_next_aggregate_verification_key_snark,
      parent_certificate_aggregate_verification_key_snark:
        bridge_parent_certificate_aggregate_verification_key_snark,
      locking_tx_merkle_proof_public_sub_root:
        bridge_locking_tx_merkle_proof_public_sub_root,
      locking_tx_merkle_proof_pi_a: bridge_locking_tx_merkle_proof_pi_a,
      locking_tx_merkle_proof_pi_b: bridge_locking_tx_merkle_proof_pi_b,
      locking_tx_merkle_proof_pi_c: bridge_locking_tx_merkle_proof_pi_c,
      locking_tx_hash: bridge_locking_tx_hash,
      locking_tx_input_output_reference_tx_id:
        bridge_locking_tx_input_output_reference_tx_id,
      locking_tx_input_output_reference_output_index:
        bridge_locking_tx_input_output_reference_output_index,
      locking_tx_output_address: bridge_locking_tx_output_address,
      locking_tx_output_lovelace: bridge_locking_tx_output_lovelace,
      locking_tx_destination_payment_credential:
        bridge_locking_tx_destination_payment_credential,
      locking_tx_asset_amount: bridge_locking_tx_asset_amount,
      locking_tx_fee: bridge_locking_tx_fee,
    },
  }

  output {
    to: LockingTxsUpdaterSpend,
    amount: locking_txs_updater_output_value,
    datum: TxsUpdaterDatum {
      merkle_root: new_merkle_root,
    },
  }

  output {
    to: User,
    amount: bridge_asset_value,
  }

  output {
    to: User,
    amount:
      locking_txs_updater_input + source + tx_snapshot_receipt - locking_txs_updater_output_value - bridge_output_ada - fees,
  }

  cardano::plutus_witness {
    version: 3,
    script: 0x585d01010029800aba2aba1aab9eaab9dab9a4888896600264646644b30013370e900118031baa0028994c004c02400660126014003375a601200891125118039baa0028b200a30063007001300600230060013003375400d149a26cac8009,
  }

}
