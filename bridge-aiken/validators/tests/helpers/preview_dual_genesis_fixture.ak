use aiken/primitive/bytearray
use aiken/primitive/string
use ak_381/groth16.{Proof}

/// Preview-network dual-genesis runtime fixture used by
/// `scripts/bridge.sh genesis_dual_signature`.
///
/// Provenance:
/// - Ed25519 / certificate half:
///   - `scripts/data/mithril_stake_distribution_genesis.json`
///   - sourced from Mithril preview genesis certificate data
/// - Schnorr / Groth16 half:
///   - `scripts/data/jubjub_schnorr_preview_genesis_raw.json`
///   - generated by `circuit_jubjub_schnorr_verification`
///   - preflight-verified by `scripts/preflight_genesis_dual_signature.sh`
///
/// This is the closest test-side mirror of the runtime experiment.
pub const signed_message_raw =
  #"30616165633461663538656363653865643230343035383038636663366430313838346333363135326430653137626339343730343730643164653039636338"

pub const ed25519_signature_raw =
  #"3863646431313930633139313437356231363034373235333961323464323639303730633034303738326164663066356166333262663839313432363530643038306461333639383666373438323763623231343938356666653262356463366664376331366338616137323933633031343830326336316230393964363065"

pub const schnorr_signature_raw =
  #"3666346264383436613237363535343964306564386131626439363366363533383530333564666634653335633962313536366538643466353536663861303931383931353865663534353365663462316435303532363765336134316333336232623265356462346162363432613965653539313634396665326137383733"

pub const digest_hi = 14199728855965937259838324339763866881

pub const digest_low = 181170718915851078100988312532102978760

pub const message_base =
  38303869458051097992556688902259873837010176979887775561446209207935168720393

pub const verification_key_u =
  28153324423867457666386337918486746564366670615804845649025564287389474821818

pub const verification_key_v =
  19834851423795617621281065444719196780261659977294753884839631378592271643792

pub const signature_response =
  4315408926006627378063707587791079234272451289797973894521736869773724633967

pub const signature_challenge =
  52228295963719051524880205251771366809414986442252057824313597543428105212184

fn decimal_ascii_bytes(value: Int) -> ByteArray {
  bytearray.from_string(string.from_int(value))
}

pub fn signed_message_ascii_hex() -> ByteArray {
  signed_message_raw
}

pub fn ed25519_signature_ascii_hex() -> ByteArray {
  ed25519_signature_raw
}

pub fn schnorr_signature_ascii_hex() -> ByteArray {
  schnorr_signature_raw
}

pub fn proof() -> Proof {
  Proof {
    piA: #"955fc0717dbaa0f57317b3d4cbccd82b5cb90bbee4225c9ce265d82f2e796f524a46607e137df1d04c838a63339c3e57",
    piB: #"8e970428e9a998a26d110f5a784860affbaf0a25dfbd991903b73ad441653321f5b48fe04b6ab53f47c0d0f140f06314001913cc6bb93f4fba85704f132b5bccec4be81e57e84000e689a281676cebf872ffcfd109488047f610b58610bad0e3",
    piC: #"970cc3aee0a9d74ea5ae0fa7941c9f4506dcb16757a376f25005ccf32d96541f13699c4ef1e15bf46319a7e4750aedab",
  }
}

pub fn message_base_bytes() -> ByteArray {
  decimal_ascii_bytes(message_base)
}

pub fn digest_hi_bytes() -> ByteArray {
  decimal_ascii_bytes(digest_hi)
}

pub fn digest_low_bytes() -> ByteArray {
  decimal_ascii_bytes(digest_low)
}

pub fn verification_key_u_bytes() -> ByteArray {
  decimal_ascii_bytes(verification_key_u)
}

pub fn verification_key_v_bytes() -> ByteArray {
  decimal_ascii_bytes(verification_key_v)
}

pub fn signature_response_bytes() -> ByteArray {
  decimal_ascii_bytes(signature_response)
}

pub fn signature_challenge_bytes() -> ByteArray {
  decimal_ascii_bytes(signature_challenge)
}
